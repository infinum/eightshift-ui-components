{
	"name": "@eightshift/ui-components",
	"version": "8.2.0",
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/infinum/eightshift-ui-components.git"
	},
	"files": [
		"dist"
	],
	"sideEffects": [
		"./dist/**/*.css"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.js"
		},
		"./icons": {
			"types": "./dist/icons/index.d.ts",
			"default": "./dist/icons/index.js"
		},
		"./jsx-svg": {
			"types": "./dist/icons/jsx-svg.d.ts",
			"default": "./dist/icons/jsx-svg.js"
		},
		"./utilities": {
			"types": "./dist/utilities/index.d.ts",
			"default": "./dist/utilities/index.js"
		},
		"./dist/assets/style.css": "./dist/assets/style.css",
		"./dist/assets/style-editor.css": "./dist/assets/style-editor.css",
		"./dist/assets/style-admin.css": "./dist/assets/style-admin.css",
		"./dist/assets/wp-overrides/fix-label-text-case.css": "./dist/assets/wp-overrides/fix-label-text-case.css",
		"./dist/assets/wp-overrides/increase-sidebar-width.css": "./dist/assets/wp-overrides/increase-sidebar-width.css",
		"./dist/assets/wp-overrides/make-block-messages-nicer.css": "./dist/assets/wp-overrides/make-block-messages-nicer.css",
		"./dist/assets/wp-overrides/restyle-tooltips.css": "./dist/assets/wp-overrides/restyle-tooltips.css",
		"./dist/assets/wp-overrides/round-corners.css": "./dist/assets/wp-overrides/round-corners.css",
		"./dist/assets/wp-overrides/unify-button-sizes.css": "./dist/assets/wp-overrides/unify-button-sizes.css",
		"./dist/assets/wp-overrides/replace-fonts.css": "./dist/assets/wp-overrides/replace-fonts.css",
		"./dist/assets/wp-overrides/allow-full-width-blocks.css": "./dist/assets/wp-overrides/allow-full-width-blocks.css",
		"./styles": "./dist/assets/style.css",
		"./styles-editor": "./dist/assets/style-editor.css",
		"./styles-admin": "./dist/assets/style-admin.css",
		"./wp-overrides/allow-full-width-blocks": "./dist/assets/wp-overrides/allow-full-width-blocks.css",
		"./wp-overrides/fix-label-text-case": "./dist/assets/wp-overrides/fix-label-text-case.css",
		"./wp-overrides/increase-sidebar-width": "./dist/assets/wp-overrides/increase-sidebar-width.css",
		"./wp-overrides/make-block-messages-nicer": "./dist/assets/wp-overrides/make-block-messages-nicer.css",
		"./wp-overrides/replace-fonts": "./dist/assets/wp-overrides/replace-fonts.css",
		"./wp-overrides/restyle-tooltips": "./dist/assets/wp-overrides/restyle-tooltips.css",
		"./wp-overrides/round-corners": "./dist/assets/wp-overrides/round-corners.css",
		"./wp-overrides/unify-button-sizes": "./dist/assets/wp-overrides/unify-button-sizes.css"
	},
	"scripts": {
		"generate:icon-loaders": "node ./scripts/generate-icon-loaders.mjs",
		"dev": "node ./scripts/generate-icon-loaders.mjs && vite",
		"start": "node ./scripts/generate-icon-loaders.mjs && vite",
		"build": "node ./scripts/generate-icon-loaders.mjs && vite build && tsc -p tsconfig.build.json",
		"typecheck": "tsc --noEmit",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"fmt": "oxfmt 'lib/**/*.{ts,tsx}' 'src/**/*.{ts,tsx}' '*.ts' 'scripts/**/*.mjs' package.json",
		"fmt:check": "oxfmt --check 'lib/**/*.{ts,tsx}' 'src/**/*.{ts,tsx}' '*.ts' 'scripts/**/*.mjs' package.json",
		"preview": "vite preview"
	},
	"peerDependencies": {
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"use-sync-external-store": "^1.6.0"
	},
	"devDependencies": {
		"@adobe/react-spectrum": "^3.47.5",
		"@atom-universe/use-web-worker": "^2.2.1",
		"@dnd-kit/abstract": "^0.5.0",
		"@dnd-kit/dom": "^0.5.0",
		"@dnd-kit/helpers": "^0.5.0",
		"@dnd-kit/react": "^0.5.0",
		"@oxlint/plugins": "1.82.0",
		"@react-stately/collections": "^3.13.1",
		"@tailwindcss/vite": "^4.3.3",
		"@thi.ng/color": "^5.8.33",
		"@types/react": "^18.3.31",
		"@types/react-dom": "^18.3.7",
		"@vitejs/plugin-react": "^6.1.1",
		"@wordpress/i18n": "^6.27.0",
		"autoprefixer": "^10.5.5",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"css-gradient-parser": "^0.0.18",
		"glob": "^13.0.6",
		"just-camel-case": "^6.2.0",
		"just-debounce-it": "^3.2.0",
		"just-has": "^2.3.0",
		"just-is-empty": "^3.4.1",
		"just-kebab-case": "^4.2.0",
		"just-throttle": "^4.2.0",
		"lightningcss": "^1.33.0",
		"oxfmt": "0.67.0",
		"oxlint": "1.82.0",
		"oxlint-tsgolint": "7.0.2001",
		"postcss": "^8.5.28",
		"react": "^18.3.1",
		"react-aria": "^3.52.1",
		"react-aria-components": "^1.21.1",
		"react-dom": "^18.3.1",
		"react-jsx-parser": "^2.4.1",
		"react-movable": "^3.4.1",
		"react-stately": "^3.50.0",
		"svg-to-jsx-string": "^0.1.1",
		"tailwindcss": "^4.3.3",
		"tailwindcss-motion": "^1.1.1",
		"tailwindcss-react-aria-components": "^2.2.0",
		"typescript": "^7.0.2",
		"vite": "^8.2.2",
		"vite-plugin-lib-inject-css": "^2.2.2"
	},
	"dependencies": {
		"@fontsource-variable/google-sans-flex": "^5.3.1",
		"@fontsource/geist": "^5.3.0",
		"@fontsource/geist-mono": "^5.3.0",
		"html-entities": "^2.6.0",
		"motion": "^13.2.0"
	}
}
